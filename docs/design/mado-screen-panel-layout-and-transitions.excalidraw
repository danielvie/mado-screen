    {"id":"panel-shortcut-141","type":"text","x":1014,"y":3962,"width":548,"height":23.75,"angle":0,"strokeColor":"#62738b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":620011,"version":1,"versionNonce":660141,"isDeleted":false,"boundElements":null,"updated":0,"link":null,"locked":false,"text":"Click to draw again. The menu remains clickable.","originalText":"Click to draw again. The menu remains clickable.","fontSize":19,"fontFamily":5,"lineHeight":1.25,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":true},
    {"id":"panel-shortcut-142","type":"text","x":60,"y":4044,"width":1015,"height":23.75,"angle":0,"strokeColor":"#243047","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":620082,"version":1,"versionNonce":660142,"isDeleted":false,"boundElements":null,"updated":0,"link":null,"locked":false,"text":"The toggle switches canvas input only. It neither hides the panel nor clears annotations.","originalText":"The toggle switches canvas input only. It neither hides the panel nor clears annotations.","fontSize":19,"fontFamily":5,"lineHeight":1.25,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":true},
    {"id":"panel-shortcut-143","type":"text","x":60,"y":4080,"width":1178,"height":22.5,"angle":0,"strokeColor":"#62738b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":620153,"version":1,"versionNonce":660143,"isDeleted":false,"boundElements":null,"updated":0,"link":null,"locked":false,"text":"Tool/color/width clicks may prepare the next annotation in click-through; they never silently enable drawing.","originalText":"Tool/color/width clicks may prepare the next annotation in click-through; they never silently enable drawing.","fontSize":18,"fontFamily":5,"lineHeight":1.25,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":true},
    {"id":"panel-shortcut-144","type":"text","x":60,"y":4116,"width":1102,"height":22.5,"angle":0,"strokeColor":"#62738b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":620224,"version":1,"versionNonce":660144,"isDeleted":false,"boundElements":null,"updated":0,"link":null,"locked":false,"text":"If a shortcut conflict prevents drawing, remain click-through, preserve ink and show the actual state.","originalText":"If a shortcut conflict prevents drawing, remain click-through, preserve ink and show the actual state.","fontSize":18,"fontFamily":5,"lineHeight":1.25,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":true}
